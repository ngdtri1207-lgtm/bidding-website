<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.controller.LoginController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Đăng nhập" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <TextField fx:id="usernameField" promptText="Tên đăng nhập" maxWidth="300"/>
    <PasswordField fx:id="passwordField" promptText="Mật khẩu" maxWidth="300"/>
    <Label fx:id="errorLabel" textFill="RED" visible="false" managed="false"/>
    <Button text="Đăng nhập" onAction="#onLoginClick" maxWidth="300" defaultButton="true"/>
    <Hyperlink text="Chưa có tài khoản? Đăng ký" onAction="#onGoToRegister"/>
</VBox>