<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo.controller.RegisterController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Đăng ký tài khoản" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <TextField fx:id="usernameField" promptText="Tên đăng nhập" maxWidth="300"/>
    <PasswordField fx:id="passwordField" promptText="Mật khẩu (tối thiểu 6 ký tự)" maxWidth="300"/>
    <PasswordField fx:id="confirmField" promptText="Nhập lại mật khẩu" maxWidth="300"/>
    <ComboBox fx:id="roleBox" promptText="Chọn vai trò" maxWidth="300"/>
    <Label fx:id="errorLabel" textFill="RED" visible="false" managed="false"/>
    <Button text="Đăng ký" onAction="#onRegisterClick" maxWidth="300" defaultButton="true"/>
    <Hyperlink text="Đã có tài khoản? Quay lại đăng nhập" onAction="#onBackToLogin"/>
</VBox>